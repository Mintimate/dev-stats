# Server-side secrets only. Never copy .env files into static deployment output.
# GitHub cards: prefer a fine-grained PAT with Public repositories only and no
# additional permissions. Public statistics do not require repo or read:user.
GITHUB_TOKEN=

# Optional comma-separated hostnames for trusted WakaTime-compatible servers.
WAKATIME_API_DOMAINS=

AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
AI_GATEWAY_MODEL=
